APP_ENV=development
# Empty disables admin access. Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=
SESSION_SECRET=
# Anonymous comments, likes and reports are an explicit opt-in demo feature.
ALLOW_ANONYMOUS_INTERACTIONS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional model dependencies/downloads are disabled by default.
MODERATION_MODEL_ENABLED=false
EMBEDDING_MODEL_ENABLED=false
EMBEDDING_MODEL_REVISION=
AI_ENRICHMENT_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_TIMEOUT_SECONDS=20
